# Sit Spot Local Configuration

# Backend Host & Port
SITSPOT_HOST=127.0.0.1
SITSPOT_PORT=8000

# Storage & Upload Limits
SITSPOT_DATA_DIR=./data
SITSPOT_MAX_AUDIO_DURATION_SEC=300
SITSPOT_MAX_FILE_SIZE_BYTES=26214400 # 25 MB

# CORS Allowed Origins
SITSPOT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
